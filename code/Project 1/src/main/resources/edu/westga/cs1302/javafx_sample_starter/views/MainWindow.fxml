<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="840.0" prefWidth="557.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.javafx_sample_starter.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Task Name" />
      <TextField fx:id="taskNameField" />
      <Label text="Description" />
      <TextArea fx:id="taskDescriptionArea" prefHeight="200.0" prefWidth="200.0" />
      <Label text="Priority" />
      <ComboBox fx:id="priorityDropdown" prefWidth="150.0" />
      <Button fx:id="submit" mnemonicParsing="false" onAction="#addTask" text="Submit" />
      <ListView fx:id="taskList" prefHeight="200.0" prefWidth="200.0" />
      <Label text="Displayed Description" />
      <TextArea fx:id="displayedDescription" prefHeight="200.0" prefWidth="200.0" />
      <Button fx:id="update" mnemonicParsing="false" onAction="#updateDescriptionTask" text="Update" />
      <Label text="Displayed Priority" />
      <TextField fx:id="displayedPriority" editable="false" />
      <Button fx:id="remove" mnemonicParsing="false" onAction="#removeTask" text="Remove" />
      <Label fx:id="highTaskNumLabel" text="Number of High Tasks:" />
      <Button fx:id="highTaskNumCounter" mnemonicParsing="false" />
      <Label fx:id="mediumTaskNumLabel" text="Number of Medium Tasks:" />
      <Button fx:id="mediumTaskNumCounter" mnemonicParsing="false" />
      <Label fx:id="lowTaskNumLabel" text="Number of Low Tasks:" />
      <Button fx:id="lowTaskNumCounter" mnemonicParsing="false" />
   </children>
</VBox>
