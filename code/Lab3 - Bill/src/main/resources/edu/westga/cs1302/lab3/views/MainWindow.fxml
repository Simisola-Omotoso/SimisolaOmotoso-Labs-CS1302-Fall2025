<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="840.0" prefWidth="557.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.lab3.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <TextField id="name" fx:id="name" promptText="Name" />
      <TextField id="amount" fx:id="amount" promptText="Amount" />
      <Button id="button" fx:id="button" mnemonicParsing="false" onAction="#initialize" text="Add Item" />
      <TextArea id="billDisplay" fx:id="billDisplay" editable="false" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
